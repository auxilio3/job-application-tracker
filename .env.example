# Copy this file to .env and fill in your own MySQL details.
# .env is listed in .gitignore, so your password never gets committed.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=job_tracker

# Any long random string; used by Flask to sign flash messages.
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=1
